# Copy to .env and fill in. .env is gitignored.
POSTGRES_USER=aisport
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aisport

# Host run (uvicorn on the machine, postgres from docker compose on localhost:5432).
# Inside docker compose the api service overrides the host to "db".
DATABASE_URL=postgresql+asyncpg://aisport:change_me@localhost:5432/aisport

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_TTL_MINUTES=43200

# Bump when the consent text changes; registration must send the same version.
CONSENT_VERSION=2026-10-v1
